{
  "name": "warrior-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Warrior — utility-first CSS component library, docs site.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
